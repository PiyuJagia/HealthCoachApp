# OpenAI
OPENAI_API_KEY=

# Google Gemini (Phase E3 — ADK agent orchestration)
GOOGLE_API_KEY=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=healthcoach-rag
PINECONE_NAMESPACE=healthcoach-knowledge-base

# RAG retrieval settings (optional; defaults shown)
RAG_TOP_K=3
RAG_MIN_RELEVANCE_SCORE=0.35

# Embedding model: text-embedding-3-small (configured in rag/embedder.py; not overridden by env)

# Health data (Phase E1)
# Local development: SQLite file under ./data/
# Production (planned): PostgreSQL, e.g. postgresql+psycopg://user:pass@host:5432/healthcoach
DATABASE_URL=sqlite:///./data/healthcoach.db
