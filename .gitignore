# Environment — never commit real keys
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Knowledge — local-only source and extraction artifacts
knowledge/raw/*
!knowledge/raw/.gitkeep
knowledge/extracted/*
!knowledge/extracted/.gitkeep
knowledge/staging/*
!knowledge/staging/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local SQLite database files (schema tracked via SQLAlchemy models)
data/*.db
data/*.db-journal

# Local review backups
*.human_review_backup

# Abandoned / companion F7 capture files (not the official scored TRACE set)
evals/results/post_remediation_traces_v1/*.raw_model.json
evals/results/post_remediation_traces_v1/run_manifest.json
